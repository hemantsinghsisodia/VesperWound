{
  "name": "vesperwound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VESPERWOUND \u2014 Fab Medic at Ash Quay",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node tools/sync-runtime.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests tools",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "assets:generate": "node tools/generate-fixtures.mjs",
    "assets:fetch": "node --use-system-ca tools/fetch-art.mjs",
    "assets:build": "node tools/build-art.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "size": "node tools/report-size.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
